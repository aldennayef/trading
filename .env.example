# === Telegram Bot ===
# Buat bot di Telegram via @BotFather, lalu masukkan token di sini
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Chat ID Telegram (bisa dapat dari @userinfobot)
TELEGRAM_CHAT_ID=your_chat_id_here

# === Trading Settings ===
# Take Profit dalam persen (default: 3.0)
TP_PERCENT=3.0

# Cut Loss dalam persen (default: 2.0)
CL_PERCENT=2.0

# === Logging ===
# Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
