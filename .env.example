# === Telegram Bot ===
# Buat bot di Telegram via @BotFather, lalu masukkan token di sini
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Chat ID Telegram (bisa dapat dari @userinfobot)
TELEGRAM_CHAT_ID=your_chat_id_here

# === LLM (Opsional — auto-detect) ===
# Jika diisi, LLM akan digunakan untuk boost confidence sinyal
# Bisa pakai OpenAI, atau provider lain yang compatible (Groq, Together, dll)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# === Confidence ===
# Minimum confidence untuk mengirim sinyal (default: 97.0)
MIN_CONFIDENCE=97.0

# === Trading Settings ===
# Take Profit default dalam persen (fallback jika ATR tidak tersedia)
TP_PERCENT=3.0

# Cut Loss default dalam persen (fallback jika ATR tidak tersedia)
CL_PERCENT=2.0

# === Logging ===
# Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
